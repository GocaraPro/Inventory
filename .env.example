# Neon pooled connection string. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
# Existing Vercel Neon integration may instead provide inventory_DATABASE_URL.
# Either name is supported; a non-empty DATABASE_URL takes priority.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
OWNER_EMAIL=
# Resend API key and a sender on a verified domain.
AUTH_RESEND_KEY=
EMAIL_FROM=Pokemon Inventory <inventory@your-domain.com>
# Separate random secret for the scheduled price import.
CRON_SECRET=
# Server-only PokemonPriceTracker key for PSA estimates (USD numeric value -> EUR 1:1).
POKEMON_PRICE_TRACKER_API_KEY=
